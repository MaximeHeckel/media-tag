{
  "name": "media-tag",
  "version": "1.1.0",
  "description": "Generate searchable keywords for local images and videos with AI, and inspect their embedded metadata.",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "bin": {
    "media-tag": "./dist/src/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "compile": "bun build ./src/index.ts --compile --outfile media-tag",
    "install:local": "pnpm compile && sudo install -m 755 ./media-tag /usr/local/bin/media-tag",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spotlight": "mdls -name kMDItemKeywords -name kMDItemDescription"
  },
  "keywords": [
    "media",
    "metadata",
    "exiftool",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "globby": "^16.2.0",
    "ora": "^9.4.0",
    "p-limit": "^7.3.0",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
