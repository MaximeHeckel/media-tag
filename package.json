{
  "name": "media-tagger-cli",
  "version": "0.1.0",
  "description": "Tag local video and image assets with AI-generated metadata keywords.",
  "type": "module",
  "bin": {
    "media-tagger": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "compile": "bun build ./src/index.ts --compile --outfile media-tagger",
    "install:local": "pnpm compile && sudo install -m 755 ./media-tagger /usr/local/bin/media-tagger",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "exif": "exiftool -G1 -a -s",
    "exif:image": "exiftool -G1 -a -s -XMP:Subject -IPTC:Keywords",
    "exif:video": "exiftool -G1 -a -s -Keys:Description -XMP:Description",
    "spotlight": "mdls -name kMDItemKeywords -name kMDItemDescription"
  },
  "keywords": [
    "media",
    "metadata",
    "exiftool",
    "ffmpeg",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.65",
    "ai": "^6.0.191",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "globby": "^16.2.0",
    "ora": "^9.4.0",
    "p-limit": "^7.3.0",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
